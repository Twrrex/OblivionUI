------------------------------------------------------------------
-- CONFIG (real-time AutoSave)
------------------------------------------------------------------
local FOLDER = "OblivionUI"
local FILE = FOLDER .. "/Config_OB.json"

local canFS = (writefile and readfile and isfile and makefolder and isfolder) and true or false

local function defaultConfig()
    return {
        JobID = game.JobId,
        Theme = "Dark Gray",
        Size = "Medium",
        SoundEnabled = true,
        Flags = {},
    }
end

local Config = defaultConfig()

local function loadConfig()
    if not canFS then return end
    local ok, data = pcall(function()
        if isfile(FILE) then
            return HttpService:JSONDecode(readfile(FILE))
        end
    end)
    if ok and type(data) == "table" then
        if Themes[data.Theme] then Config.Theme = data.Theme end
        if Sizes[data.Size] then Config.Size = data.Size end
        if type(data.SoundEnabled) == "boolean" then Config.SoundEnabled = data.SoundEnabled end
        if type(data.Flags) == "table" then Config.Flags = data.Flags end
    end
end

local function saveConfigNow()
    if not canFS then return false end
    local ok = pcall(function()
        if not isfolder(FOLDER) then makefolder(FOLDER) end
        Config.JobID = game.JobId
        writefile(FILE, HttpService:JSONEncode(Config))
    end)
    return ok
end

local saveQueued = false
local function autoSave()
    if saveQueued then return end
    saveQueued = true
    task.delay(0.25, function()
        saveQueued = false
        saveConfigNow()
    end)
end

local function deleteConfig()
    if canFS and delfile and isfile(FILE) then
        pcall(delfile, FILE)
    end
    Config = defaultConfig()
end

------------------------------------------------------------------
-- HELPERS
------------------------------------------------------------------
local Registry = {}
local Connections = {}

local function connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Connections, c)
    return c
end

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function theme(obj, prop, key)
    table.insert(Registry, { obj, prop, key })
    obj[prop] = Themes[Config.Theme][key]
end

local function applyTheme(name)
    if not Themes[name] then return end
    Config.Theme = name
    local t = Themes[name]
    for i = #Registry, 1, -1 do
        local r = Registry[i]
        if r[1] and r[1].Parent then
            r[1][r[2]] = t[r[3]]
        else
            table.remove(Registry, i)
        end
    end
    autoSave()
end

local function playSound(id)
    if not Config.SoundEnabled then return end
    local s = new("Sound", { SoundId = "rbxassetid://" .. tostring(id), Volume = 1 }, SoundService)
    s:Play()
    Debris:AddItem(s, 6)
end

local function getGuiParent()
    local ok, hui = pcall(function() return gethui and gethui() end)
    if ok and hui then return hui end
    local ok2 = pcall(function() return CoreGui.Name end)
    if ok2 then return CoreGui end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local FONT = Enum.Font.Code

local function stroke(obj, thickness)
    local s = new("UIStroke", {
        Thickness = thickness or 2,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, obj)
    theme(s, "Color", "Border")
    return s
end

local function label(parent, text, size)
    local l = new("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        Font = FONT,
        TextSize = size or 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
    theme(l, "TextColor3", "Text")
    return l
end

------------------------------------------------------------------
-- WINDOW
------------------------------------------------------------------
function OblivionUI:CreateWindow(opts)
    opts = opts or {}
    local title = opts.Title or "OblivionUI"

    -- remove old instance if re-executed
    local parentGui = getGuiParent()
    local old = parentGui:FindFirstChild("OblivionUI")
    if old then old:Destroy() end

    loadConfig()

    local gui = new("ScreenGui", {
        Name = "OblivionUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 999,
    })
    gui.Parent = parentGui

    local Window = {}
    Window.Gui = gui
    Window.NotifyTime = 4
    env.__OblivionUI = Window

    function Window:Destroy()
        Window.Dead = true
        for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
        table.clear(Connections)
        table.clear(Registry)
        if gui then gui:Destroy() end
    end

    --------------------------------------------------------------
    -- NOTIFICATIONS
    --------------------------------------------------------------
    local notifHolder = new("Frame", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -14, 1, -14),
        Size = UDim2.fromOffset(260, 400),
        ZIndex = 50,
    }, gui)
    new("UIListLayout", {
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, notifHolder)

    function Window:Notify(ntitle, text, kind, duration)
        kind = kind or "info"
        duration = duration or Window.NotifyTime or 4
        playSound(kind == "error" and Sounds.NotificationErrorID or Sounds.NotificationSoundID)

        local box = new("Frame", {
            Size = UDim2.fromOffset(250, 62),
            BorderSizePixel = 0,
            ZIndex = 50,
        }, notifHolder)
        theme(box, "BackgroundColor3", "Window")
        stroke(box, 2)

        local bar = new("Frame", { Size = UDim2.new(1, 0, 0, 18), BorderSizePixel = 0, ZIndex = 51 }, box)
        if kind == "error" then
            bar.BackgroundColor3 = Color3.fromRGB(170, 30, 30)
        else
            theme(bar, "BackgroundColor3", "Title")
        end
        new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(6, 0),
            Size = UDim2.new(1, -12, 1, 0),
            Text = ntitle or "Notice",
            Font = FONT,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextColor3 = Color3.new(1, 1, 1),
            ZIndex = 52,
        }, bar)

        local body = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(6, 22),
            Size = UDim2.new(1, -12, 1, -26),
            Text = text or "",
            Font = FONT,
            TextSize = 13,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            ZIndex = 52,
        }, box)
        theme(body, "TextColor3", "Text")

        task.delay(duration, function()
            if box and box.Parent then box:Destroy() end
        end)
    end

    --------------------------------------------------------------
    -- LOADING SCREEN (Windows style)
    --------------------------------------------------------------
    do
        local loading = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(340, 120),
            BorderSizePixel = 0,
            ZIndex = 100,
        }, gui)
        theme(loading, "BackgroundColor3", "Window")
        stroke(loading, 2)

        local lt = new("Frame", { Size = UDim2.new(1, 0, 0, 22), BorderSizePixel = 0, ZIndex = 101 }, loading)
        theme(lt, "BackgroundColor3", "Title")
        local ltt = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(8, 0),
            Size = UDim2.new(1, -16, 1, 0),
            Text = title .. " - Loading",
            Font = FONT,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 102,
        }, lt)
        theme(ltt, "TextColor3", "TitleText")

        local status = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(14, 36),
            Size = UDim2.new(1, -28, 0, 20),
            Text = "Starting...",
            Font = FONT,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 102,
        }, loading)
        theme(status, "TextColor3", "Text")

        local track = new("Frame", {
            Position = UDim2.fromOffset(14, 66),
            Size = UDim2.new(1, -28, 0, 22),
            BorderSizePixel = 0,
            ZIndex = 102,
        }, loading)
        theme(track, "BackgroundColor3", "Panel")
        stroke(track, 2)

        local fill = new("Frame", {
            Position = UDim2.fromOffset(2, 2),
            Size = UDim2.new(0, 0, 1, -4),
            BorderSizePixel = 0,
            ZIndex = 103,
        }, track)
        theme(fill, "BackgroundColor3", "Accent")

        local steps = {
            { "Loading config...", 0.25 },
            { "Applying theme: " .. Config.Theme, 0.5 },
            { "Building interface...", 0.8 },
            { "Finishing...", 1 },
        }
        for _, s in ipairs(steps) do
            status.Text = s[1]
            TweenService:Create(fill, TweenInfo.new(0.35, Enum.EasingStyle.Linear),
                { Size = UDim2.new(s[2], -4, 1, -4) }):Play()
            task.wait(0.45)
        end
        status.Text = "Success!"
        playSound(Sounds.SuccessSoundID)
        task.wait(0.6)
        loading:Destroy()
    end

    -- if another run destroyed this window while loading, stop here
    if Window.Dead or not gui.Parent then return Window end

    --------------------------------------------------------------
    -- MAIN WINDOW
    --------------------------------------------------------------
    local startSize = Sizes[Config.Size]
    local main = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(startSize.X, startSize.Y),
        BorderSizePixel = 0,
        Visible = true,
    }, gui)
    theme(main, "BackgroundColor3", "Window")
    stroke(main, 2)
    Window.Main = main

    local titleBar = new("Frame", { Size = UDim2.new(1, 0, 0, 26), BorderSizePixel = 0 }, main)
    theme(titleBar, "BackgroundColor3", "Title")

    local tt = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(1, -40, 1, 0),
        Text = title,
        Font = FONT,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, titleBar)
    theme(tt, "TextColor3", "TitleText")

    -- X button: closes the UI completely
    local closeBtn = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -4, 0.5, 0),
        Size = UDim2.fromOffset(22, 18),
        Text = "X",
        Font = FONT,
        TextSize = 13,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 5,
    }, titleBar)
    theme(closeBtn, "BackgroundColor3", "Button")
    theme(closeBtn, "TextColor3", "Text")
    stroke(closeBtn, 1)
    closeBtn.Activated:Connect(function()
        saveConfigNow()
        Window:Destroy()
    end)

    -- drag
    do
        local dragging, startPos, startMouse
        connect(titleBar.InputBegan, function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                startMouse = i.Position
                startPos = main.Position
            end
        end)
        connect(UIS.InputChanged, function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - startMouse
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        connect(UIS.InputEnded, function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    local tabBar = new("ScrollingFrame", {
        Position = UDim2.fromOffset(6, 32),
        Size = UDim2.new(0, 120, 1, -60),
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, main)
    theme(tabBar, "BackgroundColor3", "Panel")
    stroke(tabBar, 2)
    new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, tabBar)
    new("UIPadding", {
        PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
    }, tabBar)

    local pages = new("Frame", {
        Position = UDim2.fromOffset(132, 32),
        Size = UDim2.new(1, -138, 1, -60),
        BorderSizePixel = 0,
    }, main)
    theme(pages, "BackgroundColor3", "Panel")
    stroke(pages, 2)

    local statusBar = new("TextLabel", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 6, 1, -4),
        Size = UDim2.new(1, -12, 0, 18),
        BackgroundTransparency = 1,
        Text = "[LeftCtrl] Open/Close  |  AutoSave: " .. (canFS and "ON" or "OFF (no file access)"),
        Font = FONT,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, main)
    theme(statusBar, "TextColor3", "Text")

    -- Left Control toggles visibility
    connect(UIS.InputBegan, function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.LeftControl then
            main.Visible = not main.Visible
        end
    end)

    function Window:Toggle()
        main.Visible = not main.Visible
    end

    local sizeReady = false
    function Window:SetSize(name)
        local s = Sizes[name]
        if not s then return end
        Config.Size = name
        if sizeReady then
            TweenService:Create(main, TweenInfo.new(0.2), { Size = UDim2.fromOffset(s.X, s.Y) }):Play()
            autoSave()
        else
            main.Size = UDim2.fromOffset(s.X, s.Y)
        end
    end

    --------------------------------------------------------------
    -- TABS
    --------------------------------------------------------------
    local tabs = {}
    local userPicked = false
    local function selectTab(t)
        for _, o in ipairs(tabs) do
            o.Page.Visible = (o == t)
            o.TabButton.TextTransparency = (o == t) and 0 or 0.45
        end
    end

    function Window:CreateTab(name, order)
        local Tab = {}

        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 24),
            Text = name,
            Font = FONT,
            TextSize = 14,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            LayoutOrder = order or (#tabs + 1),
        }, tabBar)
        theme(btn, "BackgroundColor3", "Button")
        theme(btn, "TextColor3", "Text")
        stroke(btn, 1)

        local page = new("ScrollingFrame", {
            Size = UDim2.new(1, -8, 1, -8),
            Position = UDim2.fromOffset(4, 4),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 5,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
        }, pages)
        new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, page)
        new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 2) }, page)

        Tab.Page = page
        Tab.TabButton = btn
        Tab.Order = order or (#tabs + 1)
        table.insert(tabs, Tab)
        btn.MouseButton1Click:Connect(function()
            userPicked = true
            selectTab(Tab)
        end)
        -- until the user picks a tab, show the one with the lowest order (Main first)
        if not userPicked then
            local lowest = tabs[1]
            for _, t in ipairs(tabs) do
                if t.Order < lowest.Order then lowest = t end
            end
            selectTab(lowest)
        end

        local orderCount = 0
        local function nextOrder()
            orderCount = orderCount + 1
            return orderCount
        end

        local function row(h)
            local f = new("Frame", {
                Size = UDim2.new(1, 0, 0, h or 28),
                BorderSizePixel = 0,
                LayoutOrder = nextOrder(),
            }, page)
            theme(f, "BackgroundColor3", "Window")
            stroke(f, 1)
            return f
        end

        local function saved(flag, default)
            local v = Config.Flags[flag]
            if v == nil then return default end
            return v
        end

        function Tab:Label(text)
            local f = row(24)
            local l = label(f, text)
            l.Position = UDim2.fromOffset(8, 0)
            l.Size = UDim2.new(1, -16, 1, 0)
            return l
        end

        function Tab:Button(text, callback)
            local b = new("TextButton", {
                LayoutOrder = nextOrder(),
                Size = UDim2.new(1, 0, 0, 28),
                Text = text,
                Font = FONT,
                TextSize = 14,
                AutoButtonColor = false,
                BorderSizePixel = 0,
            }, page)
            theme(b, "BackgroundColor3", "Button")
            theme(b, "TextColor3", "Text")
            stroke(b, 2)
            b.MouseButton1Click:Connect(function()
                if callback then task.spawn(callback) end
            end)
            return b
        end

        function Tab:Toggle(text, default, callback, flag)
            flag = flag or text
            local state = saved(flag, default or false)
            local f = row(28)
            local l = label(f, text)
            l.Position = UDim2.fromOffset(8, 0)
            l.Size = UDim2.new(1, -44, 1, 0)

            local box = new("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -6, 0.5, 0),
                Size = UDim2.fromOffset(20, 20),
                Text = "",
                Font = FONT,
                TextSize = 16,
                AutoButtonColor = false,
                BorderSizePixel = 0,
            }, f)
            theme(box, "BackgroundColor3", "Panel")
            theme(box, "TextColor3", "Text")
            stroke(box, 2)

            local obj = {}
            local function set(v, silent)
                state = v
                box.Text = v and "X" or ""
                Config.Flags[flag] = v
                if not silent then autoSave() end
                if callback then task.spawn(callback, v) end
            end
            box.MouseButton1Click:Connect(function() set(not state) end)
            set(state, true)
            function obj:Set(v) set(v) end
            function obj:Get() return state end
            return obj
        end

        function Tab:Slider(text, min, max, default, callback, flag)
            flag = flag or text
            local value = math.clamp(saved(flag, default or min), min, max)
            local f = row(44)
            local l = label(f, text)
            l.Position = UDim2.fromOffset(8, 2)
            l.Size = UDim2.new(1, -60, 0, 18)
            local vl = new("TextLabel", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -8, 0, 2),
                Size = UDim2.fromOffset(50, 18),
                Font = FONT,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Right,
            }, f)
            theme(vl, "TextColor3", "Text")

            local track = new("Frame", {
                Position = UDim2.fromOffset(8, 26),
                Size = UDim2.new(1, -16, 0, 10),
                BorderSizePixel = 0,
            }, f)
            theme(track, "BackgroundColor3", "Panel")
            stroke(track, 1)
            local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0 }, track)
            theme(fill, "BackgroundColor3", "Accent")

            local function set(v, silent)
                value = math.clamp(math.floor(v + 0.5), min, max)
                fill.Size = UDim2.new((value - min) / math.max(max - min, 1), 0, 1, 0)
                vl.Text = tostring(value)
                Config.Flags[flag] = value
                if not silent then autoSave() end
                if callback then task.spawn(callback, value) end
            end
            local dragging = false
            local function fromInput(x)
                local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                set(min + (max - min) * rel)
            end
            track.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                    or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    fromInput(i.Position.X)
                end
            end)
            connect(UIS.InputChanged, function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                    or i.UserInputType == Enum.UserInputType.Touch) then
                    fromInput(i.Position.X)
                end
            end)
            connect(UIS.InputEnded, function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                    or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            set(value, true)
            local obj = {}
            function obj:Set(v) set(v) end
            function obj:Get() return value end
            return obj
        end

        function Tab:TextBox(text, default, callback, flag)
            flag = flag or text
            local f = row(28)
            local l = label(f, text)
            l.Position = UDim2.fromOffset(8, 0)
            l.Size = UDim2.new(0.4, 0, 1, 0)
            local tb = new("TextBox", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -6, 0.5, 0),
                Size = UDim2.new(0.55, 0, 0, 20),
                Text = tostring(saved(flag, default or "")),
                PlaceholderText = "...",
                ClearTextOnFocus = false,
                Font = FONT,
                TextSize = 13,
                BorderSizePixel = 0,
            }, f)
            theme(tb, "BackgroundColor3", "Panel")
            theme(tb, "TextColor3", "Text")
            stroke(tb, 1)
            tb.FocusLost:Connect(function()
                Config.Flags[flag] = tb.Text
                autoSave()
                if callback then task.spawn(callback, tb.Text) end
            end)
            Config.Flags[flag] = tb.Text
            if callback then task.spawn(callback, tb.Text) end
            return tb
        end

        -- Row of option buttons (used for Theme and Size)
        function Tab:Selector(text, options, current, callback)
            local f = row(54)
            local l = label(f, text)
            l.Position = UDim2.fromOffset(8, 2)
            l.Size = UDim2.new(1, -16, 0, 18)

            local holder = new("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(6, 24),
                Size = UDim2.new(1, -12, 0, 24),
            }, f)
            new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4) }, holder)

            local btns = {}
            local function refresh()
                for opt, b in pairs(btns) do
                    b.TextTransparency = (opt == current) and 0 or 0.5
                    b.Text = (opt == current) and ("[" .. opt .. "]") or opt
                end
            end
            for _, opt in ipairs(options) do
                local b = new("TextButton", {
                    Size = UDim2.new(1 / #options, -3, 1, 0),
                    Text = opt,
                    Font = FONT,
                    TextSize = 12,
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                }, holder)
                theme(b, "BackgroundColor3", "Button")
                theme(b, "TextColor3", "Text")
                stroke(b, 2)
                btns[opt] = b
                b.MouseButton1Click:Connect(function()
                    current = opt
                    refresh()
                    if callback then task.spawn(callback, opt) end
                end)
            end
            refresh()
            return { Get = function() return current end }
        end

        -- Error isolation: if one element fails, show the error inside the tab
        -- (red box) and keep building the rest instead of leaving the tab empty.
        for _, m in ipairs({ "Label", "Button", "Toggle", "Slider", "TextBox", "Selector" }) do
            local fn = Tab[m]
            Tab[m] = function(self, ...)
                local args = table.pack(...)
                local ok, res = pcall(function()
                    return fn(self, table.unpack(args, 1, args.n))
                end)
                if ok then return res end
                warn("[OblivionUI] " .. name .. " > " .. m .. " error: " .. tostring(res))
                pcall(function()
                    local f = new("Frame", {
                        Size = UDim2.new(1, 0, 0, 52),
                        BorderSizePixel = 0,
                        BackgroundColor3 = Color3.fromRGB(120, 20, 20),
                        LayoutOrder = nextOrder(),
                    }, page)
                    new("TextLabel", {
                        BackgroundTransparency = 1,
                        Position = UDim2.fromOffset(6, 2),
                        Size = UDim2.new(1, -12, 1, -4),
                        Text = m .. " error: " .. tostring(res),
                        Font = FONT,
                        TextSize = 12,
                        TextWrapped = true,
                        TextColor3 = Color3.new(1, 1, 1),
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextYAlignment = Enum.TextYAlignment.Top,
                    }, f)
                end)
                return { Text = "", Set = function() end, Get = function() end }
            end
        end

        return Tab
    end

    --------------------------------------------------------------
    -- CONFIG + SETTINGS TABS
    --------------------------------------------------------------
    -- safe(): if a tab fails to build, the error is shown on screen
    local function safe(name, fn)
        local ok, err = pcall(fn)
        if not ok then
            warn("[OblivionUI] " .. name .. " failed: " .. tostring(err))
            Window:Notify("UI Error", name .. ": " .. tostring(err):sub(1, 90), "error", 10)
        end
    end

    local refreshInfo = function() end

    safe("Config tab", function()
        local t = Window:CreateTab("Config", 998)

        t:Label("== Config File ==")
        t:Label("File: " .. FILE)
        t:Label("JobID: " .. (game.JobId ~= "" and game.JobId or "(Studio)"))
        t:Label("AutoSave: " .. (canFS and "ON (real time)" or "OFF (no file access)"))

        t:Label("== Current Values ==")
        local themeLbl = t:Label("")
        local sizeLbl = t:Label("")
        local soundLbl = t:Label("")
        local flagsLbl = t:Label("")
        refreshInfo = function()
            themeLbl.Text = "Theme: " .. Config.Theme
            sizeLbl.Text = "Size: " .. Config.Size
            soundLbl.Text = "Sound: " .. (Config.SoundEnabled and "ON" or "OFF")
            local n = 0
            for _ in pairs(Config.Flags) do n = n + 1 end
            flagsLbl.Text = "Saved options: " .. n
        end
        refreshInfo()

        t:Label("== Actions ==")
        t:Button("Save Config", function()
            if saveConfigNow() then
                Window:Notify("Config", "Config saved to " .. FILE, "info")
            else
                Window:Notify("Config", "Could not save (no file access).", "error")
            end
            refreshInfo()
        end)
        t:Button("Copy JobID", function()
            if setclipboard then
                setclipboard(game.JobId)
                Window:Notify("Config", "JobID copied.", "info")
            else
                Window:Notify("Config", "Clipboard not supported.", "error")
            end
        end)
        t:Button("Copy Config JSON", function()
            if setclipboard then
                setclipboard(HttpService:JSONEncode(Config))
                Window:Notify("Config", "Config JSON copied.", "info")
            else
                Window:Notify("Config", "Clipboard not supported.", "error")
            end
        end)
        t:Button("Delete Config", function()
            deleteConfig()
            refreshInfo()
            Window:Notify("Config", "Config deleted. Re-run the script to start fresh.", "error")
        end)
    end)

    safe("Settings tab", function()
        local t = Window:CreateTab("Settings", 999)

        t:Label("== Interface ==")
        t:Selector("UI Theme", ThemeOrder, Config.Theme, function(name)
            applyTheme(name)
            refreshInfo()
        end)
        t:Selector("UI Size", SizeOrder, Config.Size, function(name)
            Window:SetSize(name)
            refreshInfo()
        end)
        t:Button("Reset UI Position", function()
            main.Position = UDim2.fromScale(0.5, 0.5)
        end)

        t:Label("== Sound & Notifications ==")
        t:Toggle("Enable Sound", Config.SoundEnabled, function(v)
            Config.SoundEnabled = v
            autoSave()
            refreshInfo()
        end, "__EnableSound")
        t:Slider("Notification Time (s)", 2, 10, 4, function(v)
            Window.NotifyTime = v
        end, "__NotifyTime")
        t:Button("Test Notification", function()
            Window:Notify("Notification", "Notification sound is working!", "info")
        end)
        t:Button("Test Error", function()
            Window:Notify("Error", "Error sound is working!", "error")
        end)

        t:Label("== Other ==")
        t:Label("Toggle key: Left Control")
        t:Button("Destroy UI", function()
            saveConfigNow()
            Window:Destroy()
        end)
    end)

    sizeReady = true
    applyTheme(Config.Theme)
    saveConfigNow()

    Window:Notify("OblivionUI", "Loaded! Press Left Control to open/close.", "info")

    return Window
end

